load("@pip_deps//:requirements.bzl", "requirement")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "capacitor_mesh_generator",
    srcs = ["capacitor_mesh_generator.py"],
    deps = [
        ":mesh_generator",
        "//model:capacitor",
        requirement("gmsh"),
        requirement("numpy"),
    ],
)

py_binary(
    name = "capacitor_mesh_generator_2d_main",
    srcs = ["capacitor_mesh_generator_2d_main.py"],
    data = ["//cad/capacitor:capacitor_2d_models"],
    deps = [
        ":capacitor_mesh_generator",
        requirement("absl-py"),
    ],
)

pkg_tar(
    name = "capacitor_mesh_generator_2d_main_tar_pkg",
    srcs = [":capacitor_mesh_generator_2d_main"],
    extension = ".tar.gz",
    include_runfiles = True,
    strip_prefix = "/mesh/",
)

py_binary(
    name = "capacitor_mesh_generator_3d_main",
    srcs = ["capacitor_mesh_generator_3d_main.py"],
    data = ["//cad/capacitor:capacitor_3d_models"],
    deps = [
        ":capacitor_mesh_generator",
        requirement("absl-py"),
    ],
)

pkg_tar(
    name = "capacitor_mesh_generator_3d_main_tar_pkg",
    srcs = [":capacitor_mesh_generator_3d_main"],
    extension = ".tar.gz",
    include_runfiles = True,
    strip_prefix = "/mesh/",
)

py_library(
    name = "gmsh_interface",
    srcs = ["gmsh_interface.py"],
    deps = [
        requirement("gmsh"),
        requirement("numpy"),
    ],
)

py_library(
    name = "mesh_generator",
    srcs = ["mesh_generator.py"],
    deps = [
        ":gmsh_interface",
        ":mesh_generator_config",
        requirement("gmsh"),
        requirement("numpy"),
    ],
)

py_library(
    name = "mesh_generator_config",
    srcs = ["mesh_generator_config.py"],
)
