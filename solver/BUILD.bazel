load("@pip_deps//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "constants",
    srcs = ["constants.py"],
)

py_library(
    name = "electrostatic_solver",
    srcs = ["electrostatic_solver.py"],
    deps = [
        ":electromagnetic_solver",
        "//mesh:gmsh_interface",
        "//model:material",
        "//visualization:color_maps",
        requirement("matplotlib"),
        requirement("numpy"),
        requirement("SciencePlots"),
        requirement("scipy"),
        ":neighbor_lookup",
    ],
)

py_library(
    name = "electromagnetic_solver",
    srcs = ["electromagnetic_solver.py"],
    deps = [
        "//mesh:gmsh_interface",
        "//proto:material_py_proto",
        requirement("gmsh"),
        requirement("numpy"),
    ],
)

py_library(
    name = "capacitor_electrostatic_solver",
    srcs = ["capacitor_electrostatic_solver.py"],
    deps = [
        ":constants",
        ":electrostatic_solver",
        "//mesh:gmsh_interface",
        "//model:capacitor",
        "//model:material",
        "//proto:capacitor_py_proto",
        requirement("numpy"),
    ],
)

py_binary(
    name = "capacitor_electrostatic_solver_main",
    srcs = ["capacitor_electrostatic_solver_main.py"],
    deps = [
        ":capacitor_electrostatic_solver",
        requirement("absl-py"),
    ],
)

py_library(
    name = "capacitor_three_plates_electrostatic_solver",
    srcs = ["capacitor_three_plates_electrostatic_solver.py"],
    deps = [
        ":electrostatic_solver",
        "//model:capacitor_three_plates",
        "//model:material",
        "//proto:capacitor_three_plates_py_proto",
    ],
)

py_binary(
    name = "capacitor_three_plates_electrostatic_solver_main",
    srcs = ["capacitor_three_plates_electrostatic_solver_main.py"],
    deps = [
        ":capacitor_three_plates_electrostatic_solver",
        requirement("absl-py"),
    ],
)

py_library(
    name = "neighbor_lookup",
    srcs = ["neighbor_lookup.py"],
    deps = [requirement("numpy")],
)
