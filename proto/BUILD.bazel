load("@com_google_protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "capacitor_proto",
    srcs = ["capacitor.proto"],
)

py_proto_library(
    name = "capacitor_py_proto",
    deps = [":capacitor_proto"],
)

proto_library(
    name = "capacitor_three_plates_proto",
    srcs = ["capacitor_three_plates.proto"],
)

py_proto_library(
    name = "capacitor_three_plates_py_proto",
    deps = [":capacitor_three_plates_proto"],
)

proto_library(
    name = "complex_number_proto",
    srcs = ["complex_number.proto"],
)

proto_library(
    name = "material_proto",
    srcs = ["material.proto"],
)

py_proto_library(
    name = "material_py_proto",
    deps = [":material_proto"],
)

proto_library(
    name = "mesh_config_proto",
    srcs = ["mesh_config.proto"],
    deps = [":material_proto"],
)

py_proto_library(
    name = "mesh_config_py_proto",
    deps = [":mesh_config_proto"],
)

proto_library(
    name = "solver_config_proto",
    srcs = ["solver_config.proto"],
    deps = [":complex_number_proto"],
)

py_proto_library(
    name = "solver_config_py_proto",
    deps = [":solver_config_proto"],
)
