load("@pypi//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "electrostatic_solver",
    srcs = ["electrostatic_solver.py"],
    deps = [
        "//mesh/py:gmsh_interface",
        "//model/py:material",
        "//proto:solver_config_py_proto",
        "//solver/py:electromagnetic_solver",
        "//solver/py:neighbor_lookup",
        requirement("numpy"),
        requirement("scipy"),
    ],
)

py_library(
    name = "capacitor_electrostatic_solver",
    srcs = ["capacitor_electrostatic_solver.py"],
    deps = [
        ":electrostatic_solver",
        "//mesh/py:gmsh_interface",
        "//model/py:constants",
        "//model/py:material",
        "//proto:capacitor_py_proto",
        "//proto:solver_config_py_proto",
        requirement("numpy"),
    ],
)

py_binary(
    name = "capacitor_electrostatic_solver_2d_main",
    srcs = ["capacitor_electrostatic_solver_2d_main.py"],
    data = ["//solver/configs:capacitor_solver_configs"],
    deps = [
        ":capacitor_electrostatic_solver",
        "//proto:solver_config_py_proto",
        "//visualization/py:electromagnetic_field_plotter",
        requirement("absl-py"),
        requirement("protobuf"),
    ],
)

py_library(
    name = "capacitor_three_plates_electrostatic_solver",
    srcs = ["capacitor_three_plates_electrostatic_solver.py"],
    deps = [
        ":electrostatic_solver",
        "//model/py:material",
        "//proto:capacitor_three_plates_py_proto",
        "//proto:solver_config_py_proto",
    ],
)

py_binary(
    name = "capacitor_three_plates_electrostatic_solver_2d_main",
    srcs = ["capacitor_three_plates_electrostatic_solver_2d_main.py"],
    data = ["//solver/configs:capacitor_solver_configs_three_plates"],
    deps = [
        ":capacitor_three_plates_electrostatic_solver",
        "//proto:solver_config_py_proto",
        "//visualization/py:electromagnetic_field_plotter",
        requirement("absl-py"),
        requirement("protobuf"),
    ],
)
