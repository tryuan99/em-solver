load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "color_maps",
    srcs = ["color_maps.py"],
    deps = [requirement("matplotlib")],
)

py_library(
    name = "electromagnetic_field_plotter",
    srcs = ["electromagnetic_field_plotter.py"],
    deps = [
        ":color_maps",
        ":mpl_config",
        "//mesh/py:gmsh_interface",
        requirement("gmsh"),
        requirement("matplotlib"),
        requirement("numpy"),
        requirement("pandas"),
    ],
)

py_binary(
    name = "electromagnetic_field_plotter_2d_main",
    srcs = ["electromagnetic_field_plotter_2d_main.py"],
    deps = [
        ":electromagnetic_field_plotter",
        requirement("absl-py"),
    ],
)

py_library(
    name = "mpl_config",
    srcs = ["mpl_config.py"],
    deps = [requirement("matplotlib")],
)
